# Auto detect text files and perform LF normalization
* text=auto

# MATLAB files
*.m text eol=lf
*.mat binary
*.fig binary
*.mex* binary
*.p binary
*.slx binary
*.mdl binary

# LaTeX files
*.tex text eol=lf
*.bib text eol=lf
*.cls text eol=lf
*.sty text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
README text eol=lf
LICENSE text eol=lf
AUTHORS text eol=lf
CHANGELOG text eol=lf
CONTRIBUTING text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.eps binary
*.pdf binary

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# Exclude files from export
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
.editorconfig export-ignore
.travis.yml export-ignore
